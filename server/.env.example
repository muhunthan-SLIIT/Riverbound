# Copy this file to server/.env and fill in real values. NEVER commit server/.env.

# MongoDB Atlas connection string (Atlas > Connect > Drivers). Put your DB user and password inside it.
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DB_NAME=riverbound

# API server
PORT=4000
# The address of the React app (Vite dev server). Only this origin may call the API from a browser.
APP_ORIGIN=http://localhost:5173
NODE_ENV=development
SESSION_DAYS=7
