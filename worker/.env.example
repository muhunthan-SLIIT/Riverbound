# Copy this file to worker/.env and fill in real values. NEVER commit worker/.env.

# Same MongoDB as the server
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DB_NAME=riverbound

# Fish Game API (free, no key). Not for commercial use.
FISH_API_URL=https://marcconrad.com/uob/fish/api.php
PUZZLE_POOL_SIZE=40
PUZZLE_CRON=*/10 * * * *

# Freesound API key (free): https://freesound.org/apiv2/apply  — leave empty to use built-in fallback sounds
FREESOUND_API_KEY=
SOUND_CRON=0 3 * * *

WORKER_TIMEZONE=Asia/Colombo

# River weather (Open-Meteo, free for non-commercial use, no key needed)
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
WEATHER_CRON=*/30 * * * *
