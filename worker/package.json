{
  "name": "@riverbound/worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Riverbound background worker: fetches Fish API puzzles and Freesound sounds on a schedule.",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/index.ts",
    "start": "node --env-file-if-exists=.env src/index.ts",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@riverbound/server": "*",
    "@riverbound/shared": "*",
    "node-cron": "^4.2.1"
  }
}
