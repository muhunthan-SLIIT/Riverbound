# Copy this file to server/.env and fill in real values. NEVER commit server/.env.

# MongoDB Atlas connection string (Atlas > Connect > Drivers). Put your DB user and password inside it.
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DB_NAME=riverbound

# API server
PORT=4000
# The address of the React app (Vite dev server). Only this origin may call the API from a browser.
APP_ORIGIN=http://localhost:5173
NODE_ENV=development
SESSION_DAYS=7

# Google sign-in (optional). Leave empty to switch the "Continue with Google" button off.
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (type: Web application).
# Authorised redirect URI to add there: http://localhost:5173/api/auth/google/callback
GOOGLE_CLIENT_ID=<your-client-id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<your-client-secret>
# Only needed if Google should send players back to a different address than APP_ORIGIN:
# GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback
